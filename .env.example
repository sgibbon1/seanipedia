# Azure app client ID (from portal.azure.com — see README for setup steps)
AZURE_CLIENT_ID=your-client-id-here

# Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-key-here

# Gmail App Password for IMAP access (email_scan.py)
# Generate at: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Also ensure IMAP is enabled: Gmail Settings → See all settings → Forwarding and POP/IMAP
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where to write the Obsidian vault
# Use an absolute path, e.g. /Users/yourname/Documents/MyVault
VAULT_PATH=./vault
