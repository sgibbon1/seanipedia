# Azure app client ID (from portal.azure.com — see README for setup steps)
AZURE_CLIENT_ID=your-client-id-here

# Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-key-here

# Gmail App Password for IMAP access (email_scan.py)
# Generate at: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Also ensure IMAP is enabled: Gmail Settings → See all settings → Forwarding and POP/IMAP
GMAIL_APP_PASSWORD=your-16-char-app-password

# The inbox email_scan.py scans (usually the same account as GMAIL_APP_PASSWORD above)
MAIL_ACCOUNT=your.email@gmail.com

# Comma-separated addresses email_scan.py treats as "you" — self-sent notes only
# come from these. Usually just MAIL_ACCOUNT; add more if you send notes from
# other accounts too (e.g. a work address).
SENDER_ADDRS=your.email@gmail.com

# macOS Calendar name (exactly as it appears in Calendar.app) that daily.py
# checks for Study/Output/Career events. Leave blank to skip this feature.
STUDY_CALENDAR=

# Where to write the Obsidian vault
# Use an absolute path, e.g. /Users/yourname/Documents/MyVault
VAULT_PATH=./vault
